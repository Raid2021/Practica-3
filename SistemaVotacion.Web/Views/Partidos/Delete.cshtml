@model PartidoDto
@{
    ViewData["Title"] = "Eliminar partido";
}

<h1>Eliminar partido político</h1>

<p>¿Está seguro que desea eliminar el siguiente partido?</p>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Siglas</dt>
    <dd class="col-sm-9">@Model.Siglas</dd>
    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
