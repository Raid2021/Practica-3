@model IEnumerable<PartidoDto>
@{
    ViewData["Title"] = "Partidos políticos";
}

<h1>Partidos políticos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo partido</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Siglas</th>
            <th>Descripción</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var partido in Model)
        {
            <tr>
                <td>@partido.Nombre</td>
                <td>@partido.Siglas</td>
                <td>@partido.Descripcion</td>
                <td>@(partido.Activo ? "Sí" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
