@model VotarViewModel
@{
    ViewData["Title"] = "Votar";
}

<h1>Votación</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Votar" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Cedula" class="form-label"></label>
        <input asp-for="Cedula" class="form-control" placeholder="Ingrese su número de cédula" />
        <span asp-validation-for="Cedula" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PartidoPoliticoId" class="form-label">Partido político</label>
        <select asp-for="PartidoPoliticoId" asp-items="Model.Partidos" class="form-select">
            <option value="">-- Seleccione un partido --</option>
        </select>
        <span asp-validation-for="PartidoPoliticoId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Votar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
