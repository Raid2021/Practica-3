@model IEnumerable<VotanteDto>
@{
    ViewData["Title"] = "Votantes";
}

<h1>Votantes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo votante</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cédula</th>
            <th>Nombre completo</th>
            <th>¿Ya votó?</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var votante in Model)
        {
            <tr>
                <td>@votante.Cedula</td>
                <td>@votante.NombreCompleto</td>
                <td>@(votante.YaVoto ? "Sí" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@votante.Id" asp-route-cedula="@votante.Cedula" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@votante.Id" asp-route-cedula="@votante.Cedula" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
